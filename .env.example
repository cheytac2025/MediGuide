APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

PATIENT_DATA_ALLOW_LEGACY_PLAINTEXT=true
PATIENT_DATA_ENCRYPT_PROFILE_FIELDS=false

MEDIGUIDE_INTEGRITY_KEY=
MEDIGUIDE_INTEGRITY_KEY_VERSION=1
MEDIGUIDE_INTEGRITY_PREVIOUS_KEYS=
MEDIGUIDE_INTEGRITY_STRICT=false

MEDIGUIDE_AUDIT_KEY=
MEDIGUIDE_AUDIT_KEY_VERSION=1
MEDIGUIDE_AUDIT_PREVIOUS_KEYS=
# Empty keeps checkpoint protection inactive. No checkpoint file is in use,
# and off-machine retention is inactive. Verification checks the database
# chain only. A configured path must be absolute and outside the web root.
# Verification does not create or repair the file. The first checkpoint is
# created only by: php artisan mediguide:audit-checkpoint --execute
MEDIGUIDE_AUDIT_CHECKPOINT_PATH=

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Capstone Gmail SMTP (set only via interactive VPS script; never commit secrets):
# MAIL_MAILER=smtp
# MAIL_SCHEME=null
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your-dedicated-account@gmail.com
# MAIL_PASSWORD=google-app-password
# MAIL_FROM_ADDRESS=your-dedicated-account@gmail.com
# MAIL_FROM_NAME=MediGuide

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Put the real Anthropic key and model id in the local .env file only.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_TIMEOUT=20
ANTHROPIC_MAX_TOKENS=4096
ANTHROPIC_RETRY_MAX_TOKENS=8192

# Conservative prompt-evaluation overlay. Not a triage protocol.
AI_PROMPT_EVALUATION_ENABLED=true
AI_PROMPT_EVALUATION_EXTENDED=false

# development | imported | verified
# imported = loaded from a supplied hospital schedule, pending hospital verification
# verified = authorized hospital personnel have confirmed the stored records
HOSPITAL_DATA_SOURCE=development

# Local demonstration only. Provisional poster schedules stay hidden unless this
# is true, APP_ENV is local, and the database host is 127.0.0.1. Never enable
# this in production or on a patient-facing server.
HOSPITAL_PROVISIONAL_LOCAL_BOOKING=false

# Isolated online demo instance (demo.qmhchospital.com). Keep false on production.
# When true, provisional slots are allowed only if MEDIGUIDE_DEMO_DATABASE exactly
# matches the connected database and is not a blocked production name.
MEDIGUIDE_DEMO_INSTANCE=false
MEDIGUIDE_DEMO_DATABASE=
MEDIGUIDE_DEMO_BANNER="CAPSTONE DEMONSTRATION — schedules and appointments are synthetic and not real hospital bookings."
MEDIGUIDE_DEMO_BASIC_AUTH_USER=

# Capstone defense on the existing public site (qmhchospital.com).
# Keep HOSPITAL_PROVISIONAL_LOCAL_BOOKING=false. When true, provisional
# demonstration slots are visible and bookable only for authenticated,
# active, verified synthetic patients on the allowlist. Prefer user IDs.
MEDIGUIDE_CAPSTONE_BOOKING=false
MEDIGUIDE_CAPSTONE_BOOKING_USER_IDS=
MEDIGUIDE_CAPSTONE_BOOKING_ACCOUNTS=

# Auth security (Stage 4J). Keep require_* / enforce_* false until mail delivery is proven.
AUTH_REQUIRE_VERIFIED_PATIENT=false
# Framework "verified" middleware (settings/security/password/dashboard). Keep false in transition.
AUTH_ENFORCE_EMAIL_VERIFICATION=false
# ISO-8601. Accounts created at/after this must verify when require flag is true.
AUTH_VERIFICATION_NEW_ACCOUNT_AFTER=
# ISO-8601 absolute end of grandfather notice period. Empty = no lockout for older accounts.
AUTH_VERIFICATION_GRACE_UNTIL=
AUTH_EMAIL_OTP_ENABLED=false
AUTH_EMAIL_OTP_TTL_SECONDS=300
AUTH_EMAIL_OTP_MAX_ATTEMPTS=5
AUTH_EMAIL_OTP_RESEND_COOLDOWN_SECONDS=60
AUTH_REQUIRE_EMAIL_OTP_ALL_ROLES=false
AUTH_ACCOUNT_INVITATION_TTL_HOURS=48
AUTH_ACCOUNT_INVITATION_RESEND_COOLDOWN_SECONDS=60
AUTH_REQUIRE_TOTP_PRIVILEGED=false
